{
  "name": "@uppy/locales",
  "description": "Uppy language packs",
  "version": "5.3.2",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./*.js": "./lib/*.js",
    "./*": "./lib/*.js",
    "./lib/*.js": "./lib/*.js",
    "./lib/*": "./lib/*.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "yarn node script/build-en_US.ts && tsc --build tsconfig.build.json && yarn format",
    "format": "cd ../../ && yarn check packages/@uppy/locales/src/en_US.ts",
    "test": "yarn node script/test.ts unused && yarn node script/test.ts placeholders && yarn node script/test.ts warnings",
    "test:coverage-report": "yarn node script/test.ts warnings --verbose",
    "typecheck": "tsc --build"
  },
  "keywords": [
    "uppy",
    "uppy-plugin",
    "language packs"
  ],
  "homepage": "https://uppy.io",
  "bugs": {
    "url": "https://github.com/transloadit/uppy/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/transloadit/uppy.git"
  },
  "files": [
    "lib",
    "src",
    "dist",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@uppy/core": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@uppy-dev/tsconfig": "workspace:^",
    "typescript": "^6.0.3"
  }
}
