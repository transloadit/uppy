{
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "@uppy/core#build"],
      "inputs": ["src/**/*.{js,ts,svelte}", "package.json", "tsconfig.json"],
      "outputs": ["dist/**"]
    },
    "build:css": {
      "dependsOn": ["@uppy/svelte#build", "@uppy/components#build:css"],
      "outputs": [
        "dist/styles.css",
        "dist/image-editor.css",
        "dist/image-editor.css.map"
      ]
    }
  }
}
