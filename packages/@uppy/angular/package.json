{
  "name": "@uppy/angular",
  "description": "Angular component wrappers around Uppy's official UI plugins.",
  "version": "2.0.2",
  "license": "MIT",
  "homepage": "https://uppy.io",
  "keywords": [
    "file uploader",
    "uppy",
    "uppy-plugin",
    "angular",
    "angular-components"
  ],
  "bugs": {
    "url": "https://github.com/transloadit/uppy/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/transloadit/uppy.git"
  },
  "scripts": {
    "build": "ng-packagr -c tsconfig.lib.prod.json && node scripts/collect-dist.mjs",
    "test": "vitest run --silent='passed-only'"
  },
  "main": "./fesm2022/uppy-angular.mjs",
  "types": "./types/uppy-angular.d.ts",
  "files": [
    "fesm2022",
    "types"
  ],
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@angular/core": "^17.0.0 || ^18.0.0 || ^19.0.0 || ^20.0.0 || ^21.0.0 || ^22.0.0",
    "@uppy/core": "workspace:^",
    "@uppy/dashboard": "workspace:^",
    "@uppy/status-bar": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@uppy/dashboard": {
      "optional": true
    },
    "@uppy/status-bar": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/compiler-cli": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@uppy-dev/tsconfig": "workspace:^",
    "@vitest/browser-playwright": "^5.1.0",
    "ng-packagr": "^22.2.6",
    "playwright": "1.65.0",
    "rxjs": "~7.8.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "sideEffects": false
}
