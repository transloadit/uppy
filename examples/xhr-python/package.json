{
  "name": "example-xhr-python",
  "version": "0.0.0",
  "type": "module",
  "dependencies": {
    "@uppy/core": "*",
    "@uppy/dashboard": "*",
    "@uppy/webcam": "*",
    "@uppy/xhr-upload": "*"
  },
  "devDependencies": {
    "npm-run-all2": "^9.0.4",
    "vite": "^8.3.5"
  },
  "private": true,
  "scripts": {
    "installPythonDeps": "python3 -m pip install -r requirements.txt",
    "start": "npm-run-all --parallel start:server start:client",
    "start:client": "vite",
    "start:server": "mkdir -p uploads && python3 server.py"
  }
}
