# Copy this file to `.env` and fill in your own values.

# S3 bucket that Companion signs uploads for.
COMPANION_AWS_KEY="YOUR AWS ACCESS KEY ID"
COMPANION_AWS_SECRET="YOUR AWS SECRET ACCESS KEY"
COMPANION_AWS_BUCKET="YOUR S3 BUCKET"
COMPANION_AWS_REGION="us-east-1"

# Optional, for S3-compatible services such as MinIO or LocalStack.
# COMPANION_AWS_ENDPOINT="http://localhost:9000"
# COMPANION_AWS_FORCE_PATH_STYLE=true

# Google Drive OAuth app, only needed to import files from Google Drive.
COMPANION_GOOGLE_KEY="YOUR GOOGLE OAUTH CLIENT ID"
COMPANION_GOOGLE_SECRET="YOUR GOOGLE OAUTH CLIENT SECRET"
