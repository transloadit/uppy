# Copy this file to `.env` and fill in your own values.
# This example does not use Companion; the COMPANION_AWS_* names are shared
# with the other S3 examples.

COMPANION_AWS_KEY="YOUR AWS ACCESS KEY ID"
COMPANION_AWS_SECRET="YOUR AWS SECRET ACCESS KEY"
COMPANION_AWS_BUCKET="YOUR S3 BUCKET"
COMPANION_AWS_REGION="us-east-1"

# Optional, server-side signing only: path-style addressing for
# S3-compatible endpoints such as MinIO or LocalStack.
# COMPANION_AWS_FORCE_PATH_STYLE=true

# Optional, defaults to 8080.
# PORT=8080
