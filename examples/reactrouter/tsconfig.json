{
  "include": ["**/*", ".react-router/**/*"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "preserve",
    "noEmit": true,
    "resolveJsonModule": true,
    "rootDirs": [".", "./.react-router/types"],
    "skipLibCheck": true,
    "target": "es2022",
    "types": ["@react-router/node", "vite/client"],
    "verbatimModuleSyntax": true
  }
}
