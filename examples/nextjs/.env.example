# Copy this file to `.env` and fill in your own values.
# Only the Transloadit upload needs these; Tus and XHR work without them.

TRANSLOADIT_KEY="YOUR TRANSLOADIT AUTH KEY"
TRANSLOADIT_SECRET="YOUR TRANSLOADIT AUTH SECRET"
# Optional: without a Template ID the example sends inline resize Steps.
# TRANSLOADIT_TEMPLATE_ID="YOUR TEMPLATE ID"
