# Copy this file to `.env` and fill in your own values.

COMPANION_AWS_KEY="YOUR SPACES ACCESS KEY"
COMPANION_AWS_SECRET="YOUR SPACES SECRET KEY"
# The name of your Space.
COMPANION_AWS_BUCKET="YOUR SPACE NAME"
# A DigitalOcean region, e.g. nyc3 or ams3.
COMPANION_AWS_REGION="nyc3"

# Optional: path-style addressing instead of a subdomain per Space.
# COMPANION_AWS_FORCE_PATH_STYLE=true

# Optional, defaults to 3452.
# PORT=3452
