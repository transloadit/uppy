{
  "name": "@uppy-dev/build",
  "version": "0.0.0",
  "private": true,
  "description": "Extensible JavaScript file upload widget with support for drag&drop, resumable uploads, previews, restrictions, file processing/encoding, remote providers like Dropbox, Google Drive, S3 and more :dog:",
  "license": "MIT",
  "workspaces": [
    "examples/*",
    "packages/@uppy/*",
    "packages/uppy",
    "website",
    "private/*"
  ],
  "scripts": {
    "build": "turbo run build build:css --filter='./packages/@uppy/*' --filter='./packages/uppy'",
    "build:examples": "turbo run build typecheck check --filter='./examples/*' --filter='./private/*'",
    "build:clean": "git clean -Xfd packages .parcel-cache coverage .turbo -e '!node_modules' -e '!**/node_modules/**/*'",
    "build:watch": "yarn build && turbo watch build build:css --filter='./packages/@uppy/*' --filter='./packages/uppy'",
    "migrate:components": "yarn workspace @uppy/components migrate",
    "check": "yarn exec biome check --write",
    "check:ci": "yarn exec biome ci",
    "check:md": "remark . --frail",
    "check:mdx": "mdxlint . --frail",
    "dev": "yarn workspace @uppy-dev/dev dev",
    "dev:with-companion": "npm-run-all --parallel start:companion dev",
    "start:companion": "yarn workspace @uppy/companion start:dev",
    "test": "yarn test:release && turbo run test --concurrency=1 --filter='./packages/@uppy/*' --filter='./packages/uppy' --filter='./private/tsconfig' --filter='./examples/{react,vue,sveltekit}' -- --browser.headless",
    "test:release": "node --test scripts/release-approval.test.mjs",
    "test:e2e": "turbo run test:e2e --concurrency=1 --filter='./packages/@uppy/*' --filter='./packages/uppy' --filter='./examples/{react,vue,sveltekit}' -- --browser.headless",
    "test:watch": "turbo watch test --filter='./packages/@uppy/*' --filter='./packages/uppy'",
    "typecheck": "tsc --build && yarn workspace @uppy/svelte typecheck",
    "version": "changeset version && corepack yarn install --mode=update-lockfile && node scripts/update-readme-versions.mjs",
    "release": "node scripts/release-approval.mjs publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2",
    "mdast-comment-marker": "^3.0.0",
    "mdxlint": "^1.0.0",
    "npm-run-all2": "^9.0.3",
    "remark-cli": "^12.0.1",
    "remark-directive": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-lint-no-undefined-references": "^5.0.0",
    "remark-preset-lint-recommended": "^7.0.1",
    "remark-retext": "^6.0.1",
    "retext-english": "^5.0.0",
    "retext-equality": "^7.1.0",
    "retext-profanities": "^8.0.0",
    "retext-quotes": "^6.0.2",
    "retext-syntax-mentions": "^4.0.0",
    "turbo": "^2.11.3",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "unified-message-control": "^5.0.0"
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f",
  "engines": {
    "node": ">=22.0.0"
  }
}
