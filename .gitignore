dist/
lib/
# @uppy/svelte keeps its sources in src/lib, which `lib/` above would swallow.
# The pattern must be anchored to the repo root: a bare `!src/lib` is treated as
# `<root>/src/lib` and never matches, which also hides the directory from tools
# that watch files through .gitignore (e.g. `turbo watch`).
!packages/@uppy/svelte/src/lib/
