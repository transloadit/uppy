{
  "exclude": ["${configDir}/src"],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "module": "preserve",
    "outDir": "${configDir}/lib",
    "rootDir": "${configDir}",
    "skipLibCheck": true,
    "target": "esnext",
    "types": ["vite/client"],
    "useUnknownInCatchVariables": false,
    "verbatimModuleSyntax": true
  }
}
