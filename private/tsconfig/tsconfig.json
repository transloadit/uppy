{
  "extends": "@tsconfig/strictest/tsconfig.json",
  "exclude": ["${configDir}/src", "${configDir}/lib", "${configDir}/dist"],
  "compilerOptions": {
    "composite": true,
    "erasableSyntaxOnly": true,
    "module": "preserve",
    "noEmit": true,
    "resolveJsonModule": true,
    "rootDir": "${configDir}",
    "target": "esnext",
    "types": ["vite/client"],
    "verbatimModuleSyntax": true
  }
}
