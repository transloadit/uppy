{
  "extends": "@tsconfig/strictest/tsconfig.json",
  "include": ["${configDir}/src"],
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "erasableSyntaxOnly": true,
    "module": "nodenext",
    "outDir": "${configDir}/lib",
    "rootDir": "${configDir}/src",
    "target": "esnext",
    "verbatimModuleSyntax": true
  }
}
