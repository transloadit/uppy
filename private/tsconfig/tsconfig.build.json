{
  "include": ["${configDir}/src"],
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "erasableSyntaxOnly": true,
    "exactOptionalPropertyTypes": true,
    "module": "nodenext",
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "${configDir}/lib",
    "rootDir": "${configDir}/src",
    "skipLibCheck": true,
    "target": "esnext",
    "verbatimModuleSyntax": true
  }
}
